<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/kopiko_krem"
    tools:context=".PromoFragment">

    <!-- PROMO 1 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/kopiko_peach"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beli 2 Gratis 1"
                android:textColor="@color/kopiko_espresso"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="Berlaku untuk semua varian Es Kopi."
                android:textColor="@color/kopiko_espresso" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPakai1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pakai"
                app:backgroundTint="@color/kopiko_marun" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- PROMO 2 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/kopiko_peach"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kopi Pagi Hemat"
                android:textColor="@color/kopiko_espresso"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="Diskon 20% khusus pemesanan sebelum jam 10 pagi."
                android:textColor="@color/kopiko_espresso" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPakai2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pakai"
                app:backgroundTint="@color/kopiko_marun" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>